<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Aos.Broker\Aos.Broker.csproj" />
    <ProjectReference Include="..\Aos.Mcp.Shared\Aos.Mcp.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.0.0-rc.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net9.0-windows + UseWPF gives System.Windows.Automation (UIAutomationClient)
         and System.Drawing for screen capture with no extra packages. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Pulls System.Drawing.Common from the WindowsDesktop framework for screen capture. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>aos-mcp-windows</AssemblyName>
    <RootNamespace>Aos.Mcp.Windows</RootNamespace>
    <!-- Precompiled to native code at publish time. These are short-lived stdio processes
         spawned per agent session, so JIT warm-up is paid on every launch and never
         amortized. ReadyToRun trades a larger bin directory for a faster cold start. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
