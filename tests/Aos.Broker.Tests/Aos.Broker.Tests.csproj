<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the servers under test. Aos.Mcp.Apps is net9.0-windows for DPAPI, and a
         net9.0 test project cannot reference it. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aos.Broker\Aos.Broker.csproj" />
    <!-- The MCP servers are exe projects, but referencing them here is what lets the
         capability logic be tested directly rather than only through a live stdio server. -->
    <ProjectReference Include="..\..\src\Aos.Mcp.Files\Aos.Mcp.Files.csproj" />
    <ProjectReference Include="..\..\src\Aos.Mcp.Apps\Aos.Mcp.Apps.csproj" />
  </ItemGroup>

</Project>
